<Window x:Class="NexusClick.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:NexusClick.App" local:SpaceMotion.IsEnabled="{Binding IsChecked,ElementName=StarAnimationToggle}" Title="{local:Loc '点境 · 键鼠自动化'}" Icon="Assets/dianjing.ico" Width="1120" Height="740" MinWidth="780" MinHeight="580" Background="#050A16" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei UI" PreviewKeyDown="Window_KeyDown" PreviewKeyUp="Window_KeyUp" Deactivated="Window_Deactivated" Closing="Window_Closing">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <DataTemplate x:Key="LocalizedOption"><TextBlock Text="{local:LocBinding}"/></DataTemplate>
  <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="#101B29"/><Setter Property="Foreground" Value="#AEC2D0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Padding" Value="10,13"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="ClickNav" TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsClickPage}" Value="True"><Setter Property="Background" Value="#163A49"/><Setter Property="Foreground" Value="#59E8F5"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="MacroNav" TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsMacroPage}" Value="True"><Setter Property="Background" Value="#2B284B"/><Setter Property="Foreground" Value="#C7B2FF"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="#A8BDCA"/><Setter Property="FontSize" Value="13"/></Style>
 </Window.Resources>
 <Grid ClipToBounds="True">
  <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#040918" Offset="0"/><GradientStop Color="#0A1330" Offset="0.52"/><GradientStop Color="#100C27" Offset="1"/></LinearGradientBrush></Grid.Background>
  <Image Source="Assets/cosmos-generated-v1.png" Stretch="UniformToFill" Opacity="0.80" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>
  <Rectangle Fill="#4F030817" IsHitTestVisible="False"/>
  <local:Starfield x:Name="DeepSpaceBackdrop" IsAnimated="{Binding IsChecked,ElementName=StarAnimationToggle}"/>
  <local:PlanetArtwork x:Name="EarthGlobe" IsAnimated="{Binding IsChecked,ElementName=StarAnimationToggle}" Width="190" Height="190" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-18,220,0" Opacity="0.72"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
  <Border Background="#DE080F20" BorderBrush="#54407499" BorderThickness="0,0,1,0"><DockPanel Margin="16,26,16,20">
   <StackPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal" Margin="0,0,0,27"><Image Source="Assets/dianjing-icon.png" Width="44" Height="44" Margin="0,0,10,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{local:Loc '点境'}" Foreground="#DCF8FF" FontSize="21" FontWeight="Bold"/><TextBlock Text="D I A N J I N G" Foreground="#AAB8D8" FontSize="9" Margin="0,2,0,0"/></StackPanel></StackPanel><TextBlock Text="{local:Loc 'WORKSPACE  /  工作区'}" Foreground="#7893A4" FontSize="10" Margin="4,0,0,12"/><Button Content="{local:Loc '◉   连点引擎'}" Style="{StaticResource ClickNav}" Command="{Binding NavigateClickCommand}"/><Button Content="{local:Loc '⌘   宏引擎'}" Style="{StaticResource MacroNav}" Command="{Binding NavigateMacroCommand}"/>
    <TextBlock Text="{local:Loc '语言 / LANGUAGE'}" Foreground="#7893A4" FontSize="10" Margin="4,14,0,0"/><ComboBox SelectedIndex="{Binding Language,Source={x:Static local:Localization.Instance},Mode=TwoWay}" Margin="0,8,0,0"><ComboBoxItem Content="简体中文"/><ComboBoxItem Content="English"/><ComboBoxItem Content="日本語"/><ComboBoxItem Content="Español"/><ComboBoxItem Content="Русский"/></ComboBox><Border Background="#111F2E" BorderBrush="#263C4D" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,22,0,0"><StackPanel><TextBlock Text="{local:Loc 'LOCAL  /  本地运行'}" Foreground="#61DCC0" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="{local:Loc '基础功能版本'}" TextWrapping="Wrap" Foreground="#A8BDCA" FontSize="11" Margin="0,7,0,0"/></StackPanel></Border>
   </StackPanel>
   <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom"><TextBlock Text="{local:Loc '快捷控制'}" Foreground="#7893A4" FontSize="10" Margin="3,0,0,12"/><TextBlock Text="{local:LocBinding HotkeySidebar}" Foreground="#B5C9D4" FontSize="11" Margin="3,0,0,7"/><TextBlock Text="Ctrl + Shift + F11" Foreground="#F79CAE" FontSize="11" Margin="3,0,0,3"/><TextBlock Text="{local:Loc '全局紧急停止'}" TextWrapping="Wrap" Foreground="#F79CAE" FontSize="10" Margin="3,0,0,7"/><TextBlock Text="{local:Loc 'F12   窗口内停止'}" Foreground="#91A8B7" FontSize="11" Margin="3,0,0,0"/></StackPanel>
  </DockPanel></Border>
  <Grid Grid.Column="1" Background="#39040B1A"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="28,25,24,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{local:Loc '点境  /  DEEP SPACE CONTROL'}" Foreground="#9EC5E0" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{local:LocBinding PageTitle}" FontSize="25" FontWeight="Bold" Margin="0,8,0,3"/><TextBlock Text="{local:LocBinding PageSubtitle}" Foreground="#A4BAC8" FontSize="12" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="10,0,0,0" HorizontalAlignment="Right"><Border Background="#A3192C3D" BorderBrush="#7769CAE1" BorderThickness="1" CornerRadius="8" Padding="10,6" HorizontalAlignment="Right"><TextBlock Text="{local:Loc '✦  DEEP SPACE'}" Foreground="#A6EFFF" FontSize="10" FontWeight="SemiBold"/></Border><Border Background="#C5091325" CornerRadius="6" Padding="7,5" Margin="0,8,0,0" HorizontalAlignment="Right"><CheckBox x:Name="StarAnimationToggle" Content="{local:Loc '动态星空与地球'}" IsChecked="True" Foreground="#F0F9FF" FontSize="12" ToolTip="{local:Loc '关闭后停止星空、地球和按钮脉冲动画'}"/></Border></StackPanel></Grid>
   <Grid Grid.Row="1" Margin="28,0,24,0">
    <TabControl Visibility="{Binding IsClickPage,Converter={StaticResource BoolVisibility}}"><TabItem Header="{local:Loc '基础设置'}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Border Background="#E6101D33" BorderBrush="#664991AE" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,8,12"><StackPanel>      <TextBlock Text="{local:Loc '连点参数'}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{local:Loc '运行中修改的参数将在下一次启动时生效。'}" Foreground="#A3B9C7" FontSize="12" Margin="0,5,0,18" TextWrapping="Wrap"/>
      <TextBlock Text="{local:Loc '输入类型'}" Style="{StaticResource FieldLabel}"/><ComboBox ItemTemplate="{StaticResource LocalizedOption}" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}"/>
      <TextBlock Text="{local:Loc '鼠标按钮（鼠标模式）'}" Style="{StaticResource FieldLabel}"/><ComboBox ItemTemplate="{StaticResource LocalizedOption}" ItemsSource="{Binding Buttons}" SelectedItem="{Binding Button}"/>
      <TextBlock Text="{local:Loc '连按按键（键盘模式）'}" Style="{StaticResource FieldLabel}"/><DockPanel Margin="0,6,0,14"><Button DockPanel.Dock="Right" Content="{local:LocBinding CaptureButtonText}" Command="{Binding CaptureCommand}" Margin="10,0,0,0"/><Border Background="#1A2939" BorderBrush="#405C70" BorderThickness="1" CornerRadius="6" Padding="10,9"><TextBlock Text="{local:LocBinding KeyDisplay}" FontWeight="SemiBold" Foreground="#F3FAFE"/></Border></DockPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{local:Loc '频率（次 / 秒）'}" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Frequency,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{local:Loc '保持时间（毫秒）'}" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Hold,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid>
</StackPanel></Border></ScrollViewer></TabItem><TabItem Header="{local:Loc '快捷操作'}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Border Background="#E6101D33" BorderBrush="#664991AE" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,8,12"><StackPanel><TextBlock Text="{local:Loc '触发方式（快捷键）'}" Style="{StaticResource FieldLabel}"/><ComboBox ItemTemplate="{StaticResource LocalizedOption}" ItemsSource="{Binding TriggerModes}" SelectedItem="{Binding TriggerMode}"/><TextBlock Text="{local:Loc '启动快捷键（F1–F10）'}" Style="{StaticResource FieldLabel}"/><DockPanel Margin="0,6,0,14"><Button DockPanel.Dock="Right" Content="{local:LocBinding HotkeyButtonText}" Command="{Binding CaptureHotkeyCommand}" Margin="10,0,0,0"/><Border Background="#1A2939" BorderBrush="#405C70" BorderThickness="1" CornerRadius="6" Padding="10,9"><TextBlock Text="{Binding StartHotkeyLabel}" FontWeight="SemiBold" Foreground="#F3FAFE"/></Border></DockPanel><TextBlock Text="{local:Loc '按住触发仅适用于连点；松开快捷键后停止。'}" Foreground="#B6C9DB" FontSize="12" Margin="0,0,0,14" TextWrapping="Wrap"/></StackPanel></Border></ScrollViewer></TabItem><TabItem Header="{local:Loc '运行限制'}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Border Background="#E6101D33" BorderBrush="#664991AE" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,8,12"><StackPanel><TextBlock Text="{local:Loc '随机间隔（0–50%）'}" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding RandomInterval,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{local:Loc '0 为固定周期；最短周期限制为 20 毫秒。'}" Foreground="#B6C9DB" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"/>      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{local:Loc '爆发次数（0 关闭）'}" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding BurstCount,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{local:Loc '每轮休息（毫秒）'}" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding BurstRest,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid><TextBlock Text="{local:Loc '每完成一轮后休息；暂停期间也会经过休息时间。'}" Foreground="#B6C9DB" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{local:Loc '执行次数（0 表示无限）'}" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Repeats,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{local:Loc '最长时间（秒，0 为无限）'}" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding MaxDuration,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid><TextBlock Text="{local:Loc '最长时间包含暂停；任一限制达到后自动停止。'}" Foreground="#B6C9DB" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"/>
</StackPanel></Border></ScrollViewer></TabItem><TabItem Header="{local:Loc '点击位置'}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Border Background="#E6101D33" BorderBrush="#664991AE" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,8,12"><StackPanel>      <Border Background="#0D1724" BorderBrush="#263D4D" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,4,0,0"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="{local:LocBinding PickPositionText}" Command="{Binding PickPositionCommand}" Padding="10,6" Margin="8,0,0,0"/><CheckBox Content="{local:Loc '固定屏幕坐标（物理像素）'}" IsChecked="{Binding Fixed}" Foreground="#D4E4EC" VerticalAlignment="Center"/></DockPanel><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="X" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding X,UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Y" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Y,UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0"/></StackPanel></Grid></StackPanel></Border></StackPanel></Border></ScrollViewer></TabItem></TabControl>
    <TabControl Visibility="{Binding IsMacroPage,Converter={StaticResource BoolVisibility}}"><TabItem Header="{local:Loc '步骤编辑'}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Border Background="#E6191934" BorderBrush="#777B63B4" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,8,12"><StackPanel>      <DockPanel><Border DockPanel.Dock="Right" Background="#2B284B" CornerRadius="6" Padding="8,4"><TextBlock Text="{local:Loc 'SEQUENCE'}" Foreground="#C6B3FF" FontSize="10"/></Border><TextBlock Text="{local:Loc '步骤编排'}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBlock Text="{local:Loc '录制按键会追加到当前步骤；导入不会自动执行。'}" Foreground="#A3B9C7" FontSize="12" Margin="0,6,0,12" TextWrapping="Wrap"/>
      <DockPanel Margin="0,0,0,14"><Button DockPanel.Dock="Left" Content="{local:LocBinding RecordButtonText}" Command="{Binding RecordCommand}" Background="#553045" Foreground="#FFE3E9"/><TextBlock Text="{local:LocBinding RecordingIndicator}" Foreground="#EAB9C9" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap"/></DockPanel>
      <TextBlock Text="{local:Loc '宏名称'}" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding MacroName,UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="{local:Loc '按键步骤使用的目标键'}" Style="{StaticResource FieldLabel}"/><DockPanel Margin="0,6,0,14"><Button DockPanel.Dock="Right" Content="{local:LocBinding CaptureButtonText}" Command="{Binding CaptureCommand}" Margin="10,0,0,0"/><Border Background="#1A2939" BorderBrush="#405C70" BorderThickness="1" CornerRadius="6" Padding="10,9"><TextBlock Text="{local:LocBinding KeyDisplay}" FontWeight="SemiBold" Foreground="#F3FAFE"/></Border></DockPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{local:Loc '步骤类型'}" Style="{StaticResource FieldLabel}"/><ComboBox ItemTemplate="{StaticResource LocalizedOption}" ItemsSource="{Binding MacroStepTypes}" SelectedItem="{Binding MacroStepType}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{local:Loc '步骤时长（毫秒）'}" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding MacroDuration,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid>
      <WrapPanel><Button Content="{local:Loc '＋ 添加'}" Command="{Binding MacroAddCommand}"/><Button Content="{local:Loc '替换'}" Command="{Binding MacroReplaceCommand}"/><Button Content="{local:Loc '复制'}" Command="{Binding MacroDuplicateCommand}"/><Button Content="{local:Loc '删除'}" Command="{Binding MacroRemoveCommand}"/><Button Content="↑" Command="{Binding MacroUpCommand}"/><Button Content="↓" Command="{Binding MacroDownCommand}"/></WrapPanel>
      <ListBox ItemTemplate="{StaticResource LocalizedOption}" ItemsSource="{Binding MacroSteps}" SelectedIndex="{Binding MacroSelected}" Background="#182638" Foreground="#EAF6FC" BorderBrush="#405C70" Height="135" Margin="0,12,0,16"/>
</StackPanel></Border></ScrollViewer></TabItem><TabItem Header="{local:Loc '运行与文件'}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Border Background="#E6191934" BorderBrush="#777B63B4" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,8,12"><StackPanel>      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{local:Loc '执行轮数'}" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding MacroRepeats,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{local:Loc '最长时间（秒，含暂停）'}" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding MacroTimeout,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid>
      <WrapPanel><Button Content="{local:Loc '新建'}" Command="{Binding MacroNewCommand}"/><Button Content="{local:Loc '保存 JSON'}" Command="{Binding MacroSaveCommand}"/><Button Content="{local:Loc '加载 JSON'}" Command="{Binding MacroLoadCommand}"/></WrapPanel></StackPanel></Border></ScrollViewer></TabItem></TabControl>
   </Grid>
   <Border Grid.Row="2" BorderBrush="#223748" BorderThickness="0,1,0,0" Background="#EE090F20" Padding="28,14,24,15"><StackPanel><WrapPanel><Button Content="{local:Loc '▶  开始 / 继续'}" Command="{Binding ClickRunCommand}" Tag="Pulse" Visibility="{Binding IsClickPage,Converter={StaticResource BoolVisibility}}" Background="#32DFF2" Foreground="#07151B" FontWeight="Bold"/><Button Content="{local:Loc '▶  运行 / 继续宏'}" Command="{Binding MacroRunCommand}" Tag="Pulse" Visibility="{Binding IsMacroPage,Converter={StaticResource BoolVisibility}}" Background="#A890F7" Foreground="#171126" FontWeight="Bold"/><Button Content="{local:Loc 'Ⅱ  暂停'}" Command="{Binding PauseCommand}"/><Button Content="{local:Loc '■  停止'}" Command="{Binding StopCommand}" Background="#4A2633"/><Button Content="{local:Loc '重试释放'}" Command="{Binding RetryCommand}"/></WrapPanel><TextBlock Text="{local:LocBinding Notice}" TextWrapping="Wrap" Foreground="#FFD8A3" FontSize="11" Margin="0,10,0,0"/></StackPanel></Border>
  </Grid>
  <Border Grid.Column="2" Background="#A50B1025" BorderBrush="#544A5D86" BorderThickness="1,0,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20,28"><TextBlock Text="{local:Loc '运行监控'}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{local:Loc 'LIVE  /  当前或上次任务'}" TextWrapping="Wrap" Foreground="#7C98A8" FontSize="10" Margin="0,5,0,16"/>
   <Border Background="#B50C1831" BorderBrush="#66528EAB" BorderThickness="1" CornerRadius="14" Padding="12"><StackPanel><Border Background="#B909172A" CornerRadius="8" Padding="8,7" Margin="0,3,0,0"><StackPanel><TextBlock Text="{local:LocBinding State}" Foreground="#85F2FF" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center"/><TextBlock Text="{local:LocBinding ActiveTask}" Foreground="#C4D7E8" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></Border></StackPanel></Border>
   <UniformGrid Columns="2" Margin="0,12,0,8"><Border Background="#5B14263A" CornerRadius="7" Margin="0,0,6,6" Padding="8"><StackPanel><TextBlock Text="{local:Loc '已完成操作（宏为步骤数）'}" Foreground="#A8BDCA" FontSize="10" TextWrapping="Wrap"/><TextBlock Text="{Binding Count}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border><Border Background="#5B14263A" CornerRadius="7" Margin="0,0,6,6" Padding="8"><StackPanel><TextBlock Text="{local:Loc '活动时长'}" Foreground="#A8BDCA" FontSize="10" TextWrapping="Wrap"/><TextBlock Text="{Binding Elapsed}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border><Border Background="#5B14263A" CornerRadius="7" Margin="0,0,6,6" Padding="8"><StackPanel><TextBlock Text="{local:Loc '实际平均频率'}" Foreground="#A8BDCA" FontSize="10" TextWrapping="Wrap"/><TextBlock Text="{local:LocBinding Average}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border><Border Background="#5B14263A" CornerRadius="7" Margin="0,0,6,6" Padding="8"><StackPanel><TextBlock Text="{local:Loc '近 2 秒实际频率'}" Foreground="#A8BDCA" FontSize="10" TextWrapping="Wrap"/><TextBlock Text="{local:LocBinding Recent}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border><Border Background="#5B14263A" CornerRadius="7" Margin="0,0,6,6" Padding="8"><StackPanel><TextBlock Text="{local:Loc '宏运行位置'}" Foreground="#A8BDCA" FontSize="10" TextWrapping="Wrap"/><TextBlock Text="{local:LocBinding MacroProgress}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border></UniformGrid><Separator Background="#293E50"/><TextBlock Text="{local:Loc '点击测试区'}" FontWeight="SemiBold" FontSize="14" Margin="0,16,0,6"/><TextBlock Text="{local:Loc '此处统计测试按钮实际收到的点击。'}" TextWrapping="Wrap" Foreground="#B3C8D6" FontSize="11" Margin="0,0,0,9"/><Button Content="{local:LocBinding TestClicks}" Command="{Binding TestClickCommand}" Margin="0,0,0,8" Padding="8,14" Background="#193849"/><Button Content="{local:Loc '清零测试'}" Command="{Binding ResetTestCommand}" Margin="0,0,0,12" Padding="8,7"/><Separator Background="#293E50"/><TextBlock Text="{local:LocBinding HotkeyStatus}" TextWrapping="Wrap" Foreground="#AFC3D0" FontSize="11" Margin="0,15,0,0"/><TextBlock Text="{local:Loc '速度受 Windows 调度及目标程序影响。'}" TextWrapping="Wrap" Foreground="#91A8B7" FontSize="11" Margin="0,12,0,0"/>
  </StackPanel></ScrollViewer></Border>
 </Grid>
 </Grid>
</Window>










